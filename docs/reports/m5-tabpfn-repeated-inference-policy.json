{
  "schema_version": 2,
  "scientific_tabpfn_version": "8.0.8",
  "diagnostic_only_versions": ["8.1.0"],
  "tabpfn_8_1_0_scope": {
    "allowed_interpretation": "isolated_live_repeat_diagnostic",
    "excluded_from": ["factorial_estimation", "model_comparison", "path_a_decision", "paper_results"]
  },
  "estimand": {
    "formula": "Y[c,s,a,r] = mu[c,s,a] + epsilon[c,s,a,r]",
    "cell": "hotwater positive-support x negative-support factorial cell",
    "context_seed": "s",
    "scaler_arm": "a",
    "inference_replicate": "r",
    "composition_effect": "mu",
    "measurement_variation": "epsilon"
  },
  "endpoint_schema": {
    "steam": {
      "role": "primary_path_a_mechanism_outcome",
      "readouts": [
        "steam_positive_vs_hotwater_negative_pairwise_auc",
        "steam_positive_minus_hotwater_negative_score_margin",
        "steam_positive_global_rank",
        "steam_positive_within_meter_rank",
        "steam_anomaly_segment_movement"
      ]
    },
    "hotwater": {
      "role": "support_lever_and_manipulation_diagnostic",
      "readouts": [
        "hw01_anomaly_vs_normal_pairwise_auc",
        "hw01_within_meter_rank_gap",
        "hw_anomaly_minus_normal_score_margin"
      ]
    },
    "chilledwater": {
      "role": "conditional_mechanism_boundary_readout",
      "requires_pre_fit_resolution_audit": true,
      "readouts": [
        "chilledwater_positive_vs_hotwater_negative_pairwise_auc",
        "chilledwater_positive_minus_hotwater_negative_score_margin",
        "chilledwater_within_meter_anomaly_vs_normal_auc",
        "chilledwater_within_meter_rank_gap",
        "chilledwater_segment_summary",
        "tabpfn_minus_tree_factorial_response"
      ]
    }
  },
  "variance_pilot": {
    "status": "designed_not_running",
    "tabpfn_version": "8.0.8",
    "checkpoint": "v3",
    "feature_set": "F4_137",
    "context_n": 20000,
    "context_seed": 42,
    "model_seed": 42,
    "scaler_arm": "cell_specific",
    "cells": ["11", "10", "01", "00"],
    "query": "original_352_row_screening_query",
    "fits_per_cell": 1,
    "main_inference_mode": "same_process",
    "cell_schedule": "pre_generated_seeded_randomized_interleaving",
    "initial_replicates_per_cell": 8,
    "maximum_replicates_per_cell": 40,
    "bounded_metric_ci_half_width_target": 0.015,
    "continuous_margin_ci_half_width_iqr_multiplier": 0.02,
    "fresh_process_role": "limited_diagnostic_only"
  },
  "forbidden_this_round": [
    "pilot_execution",
    "24_cell_grid",
    "192_row_query_scoring",
    "path_b",
    "tree_refit",
    "full_holdout",
    "new_tabpfn_version",
    "paper_manuscript_change"
  ]
}
